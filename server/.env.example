# Port Backend Server
PORT=3001

# Koneksi Database PostgreSQL (Otomatis fallback ke SQL lokal sociacare.sql.db jika service PostgreSQL belum aktif)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/sociacare

# Google Gemini API Key
GEMINI_API_KEY=

# Password Admin Panel (/admin)
ADMIN_PASSWORD=admin123

# Port Backend Server
PORT=3001
HOST=127.0.0.1
NODE_ENV=production

# Session secret untuk verifikasi token admin & guru (64 karakter hex)
SESSION_SECRET=

# Koneksi Database PostgreSQL (Otomatis fallback ke SQL lokal sociacare.sql.db jika service PostgreSQL belum aktif)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/sociacare

# Google Gemini API Key
GEMINI_API_KEY=

# Google Gemini Model Configuration
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-2.5-flash,gemini-2.0-flash

# DeepSeek API (Fallback Terakhir sebelum Konselor Lokal)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Password Admin Panel (/admin) - Wajib ganti ke password rahasia dan kuat (minimal 12 karakter)
ADMIN_PASSWORD=

# Allowed CORS Origins (pisahkan dengan koma)
ALLOWED_ORIGINS=https://sociacare.my.id,https://www.sociacare.my.id

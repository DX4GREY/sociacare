# Node Environment
NODE_ENV=production

# Port Backend Server (bind ke 127.0.0.1 via Express)
PORT=3001

# Random Session Secret untuk menandatangani token auth (misal hasil dari: openssl rand -hex 32)
SESSION_SECRET=

# Koneksi Database PostgreSQL (Disarankan menggunakan user non-superuser aplikasi, misal: sociacare_app)
# Jika PostgreSQL belum aktif, sistem otomatis beralih ke engine SQL lokal (sociacare.sql.db) dengan hak akses privat (chmod 600).
DATABASE_URL=postgresql://sociacare_app:password_database_kuat@127.0.0.1:5432/sociacare?sslmode=disable

# Google Gemini API Key
GEMINI_API_KEY=

# Google Gemini Model Configuration
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-2.5-flash,gemini-2.0-flash

# DeepSeek API (Fallback Terakhir sebelum Konselor Lokal)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Password Admin Panel (/admin) - WAJIB gunakan password acak yang kuat (minimal 16-32 karakter)
ADMIN_PASSWORD=ganti_dengan_password_admin_yang_sangat_kuat_dan_acak_32karakter
